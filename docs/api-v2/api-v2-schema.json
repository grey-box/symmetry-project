{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/grey-box/symmetry-project/develop/docs/api-v2/api-v2-schema.json",
  "title": "Symmetry API v2 published schema",
  "description": "Machine-readable form of api-v2-response-schema.md. No root type: validate payloads against #/$defs/ComparisonRequest, #/$defs/ComparisonResponse or #/$defs/ErrorResponse. Strict (additionalProperties: false) for server contract tests only.",
  "$defs": {
    "Alignment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
        },
        "target_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Ref"
        },
        "category": {
          "enum": [
            "equal",
            "modified",
            "missing",
            "added"
          ],
          "title": "Category",
          "type": "string"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Similarity"
        },
        "word_diff": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/WordToken"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Word Diff"
        }
      },
      "required": [
        "id",
        "source_ref",
        "target_ref",
        "category",
        "similarity",
        "word_diff"
      ],
      "title": "Alignment",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "heading",
            "paragraph",
            "blockquote",
            "list",
            "table",
            "image"
          ],
          "title": "Type",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "section_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Section Ref"
        },
        "level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Caption"
        }
      },
      "required": [
        "id",
        "type",
        "span",
        "section_ref",
        "level",
        "url",
        "caption"
      ],
      "title": "Block",
      "type": "object"
    },
    "ComparisonOptions": {
      "additionalProperties": false,
      "properties": {
        "similarity_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Threshold"
        },
        "partial_threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Threshold"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "both",
                "first_to_second"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "pivot_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pivot Language"
        },
        "include_source_text": {
          "default": true,
          "title": "Include Source Text",
          "type": "boolean"
        },
        "include_blocks": {
          "default": true,
          "title": "Include Blocks",
          "type": "boolean"
        },
        "include_evidence": {
          "default": true,
          "title": "Include Evidence",
          "type": "boolean"
        },
        "include_word_diff": {
          "default": false,
          "title": "Include Word Diff",
          "type": "boolean"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "title": "ComparisonOptions",
      "type": "object"
    },
    "ComparisonRequest": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "text_vs_text",
            "llm_vs_wikipedia",
            "llm_vs_llm"
          ],
          "title": "Mode",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceInput"
          },
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "engines": {
          "items": {
            "type": "string"
          },
          "title": "Engines",
          "type": "array"
        },
        "strategy": {
          "anyOf": [
            {
              "enum": [
                "semantic_similarity",
                "factual_consistency"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy"
        },
        "options": {
          "$ref": "#/$defs/ComparisonOptions"
        }
      },
      "required": [
        "mode",
        "sources"
      ],
      "title": "ComparisonRequest",
      "type": "object"
    },
    "ComparisonResponse": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        },
        "mode": {
          "enum": [
            "text_vs_text",
            "llm_vs_wikipedia",
            "llm_vs_llm"
          ],
          "title": "Mode",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "semantic_similarity",
            "factual_consistency"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 2,
          "title": "Sources",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/Result"
          },
          "title": "Results",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "status",
        "mode",
        "strategy",
        "prompt",
        "duration_ms",
        "sources",
        "results",
        "errors"
      ],
      "title": "ComparisonResponse",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "embedding",
            "local_slm",
            "cloud_llm",
            "openrouter"
          ],
          "title": "Type",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "fallback_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fallback From"
        }
      },
      "required": [
        "id",
        "type",
        "provider",
        "model",
        "fallback_from"
      ],
      "title": "Engine",
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unsupported_engine",
            "unsupported_strategy",
            "source_not_found",
            "rate_limited",
            "engine_bad_output",
            "engine_unavailable",
            "engine_timeout",
            "internal_error"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "scope": {
          "enum": [
            "request",
            "source",
            "engine"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "engine_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Engine Id"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Details"
        }
      },
      "required": [
        "code",
        "message",
        "scope",
        "source_id",
        "engine_id",
        "retryable",
        "details"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "title": "Api Version",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorDetail"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "api_version",
        "request_id",
        "status",
        "errors"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "counterpart_statement",
            "wikipedia_passage",
            "model_rationale"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "statement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statement Id"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "kind",
        "source_id",
        "statement_id",
        "text",
        "url"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GeneratedBy": {
      "additionalProperties": false,
      "properties": {
        "engine_id": {
          "title": "Engine Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "engine_id",
        "provider",
        "model",
        "usage"
      ],
      "title": "GeneratedBy",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "source_ids": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Source Ids",
          "type": "array"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "direction": {
          "enum": [
            "both",
            "first_to_second"
          ],
          "title": "Direction",
          "type": "string"
        },
        "comparison_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Comparison Language"
        },
        "overall_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overall Score"
        },
        "score_basis": {
          "anyOf": [
            {
              "enum": [
                "cosine_similarity",
                "model_reported",
                "rule_based"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score Basis"
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "title": "Statements",
          "type": "array"
        },
        "alignments": {
          "items": {
            "$ref": "#/$defs/Alignment"
          },
          "title": "Alignments",
          "type": "array"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_ids",
        "engine",
        "status",
        "direction",
        "comparison_language",
        "overall_score",
        "score_basis",
        "statements",
        "alignments",
        "usage"
      ],
      "title": "Result",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "document",
            "wikipedia",
            "llm_output"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "revision_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision Id"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "License"
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attribution"
        },
        "generated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "blocks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Block"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocks"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "language",
        "url",
        "revision_id",
        "license",
        "attribution",
        "generated_by",
        "text",
        "blocks"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourceInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "document",
            "wikipedia",
            "llm_output"
          ],
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
